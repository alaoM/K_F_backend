<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Seller Application Received — FKstores</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f8;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f8;padding:40px 0;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:16px;overflow:hidden;border:1px solid #e5e7eb;max-width:600px;width:100%;">

          <!-- Header -->
          <tr>
            <td style="background:linear-gradient(135deg,#243e6b 0%,#1a2b4a 100%);padding:36px 40px;text-align:center;">
              <h1 style="margin:0;font-size:30px;font-weight:900;color:#f6c947;">FKstores</h1>
              <p style="margin:4px 0 0;font-size:11px;font-weight:700;color:rgba(255,255,255,0.6);text-transform:uppercase;letter-spacing:4px;">fkstores.com</p>
            </td>
          </tr>
          <tr><td style="height:4px;background:#f6c947;"></td></tr>

          <!-- Body -->
          <tr>
            <td style="padding:40px;">

              <!-- Status badge -->
              <div style="text-align:center;margin-bottom:28px;">
                <div style="display:inline-block;background-color:#fefce8;border:2px solid #fde047;border-radius:50%;width:64px;height:64px;line-height:64px;font-size:30px;">🏪</div>
              </div>

              <h2 style="margin:0 0 6px;font-size:24px;font-weight:900;color:#243e6b;text-align:center;">Seller Profile Created!</h2>
              <p style="margin:0 0 28px;font-size:13px;color:#f6c947;font-weight:700;text-transform:uppercase;letter-spacing:3px;text-align:center;">Application Under Review</p>

              <p style="font-size:15px;color:#374151;line-height:1.7;margin:0 0 16px;">
                Hello <strong style="color:#243e6b;">{{name}}</strong>,
              </p>

              <p style="font-size:15px;color:#374151;line-height:1.7;margin:0 0 20px;">
                Congratulations on setting up your store <strong>{{businessName}}</strong>! We have received your seller onboarding details and our merchant review team is now reviewing your application.
              </p>

              <!-- Review Steps Box -->
              <div style="background-color:#f9fafb;border-radius:12px;padding:24px;margin-bottom:28px;border:1px solid #f3f4f6;">
                <p style="margin:0 0 12px;font-size:13px;font-weight:700;color:#243e6b;text-transform:uppercase;letter-spacing:2px;">What Happens Next?</p>
                <ol style="margin:0;padding-left:20px;font-size:14px;color:#374151;line-height:1.9;">
                  <li><strong>Verification:</strong> Our team checks your business information (usually within 24–48 hours).</li>
                  <li><strong>Approval Email:</strong> You will receive an instant notification as soon as your store is verified.</li>
                  <li><strong>Start Selling:</strong> Once approved, your products and storefront will be visible to thousands of buyers.</li>
                </ol>
              </div>

              <!-- CTA -->
              <div style="text-align:center;margin:8px 0 28px;">
                <a href="{{dashboardUrl}}"
                   style="background-color:#f6c947;color:#243e6b;padding:16px 48px;text-decoration:none;border-radius:10px;font-size:15px;font-weight:900;display:inline-block;letter-spacing:1px;text-transform:uppercase;">
                  Go to Seller Dashboard
                </a>
              </div>

              <p style="font-size:13px;color:#6b7280;line-height:1.6;margin:0;text-align:center;">
                Need help or have questions? Contact our merchant support at <a href="mailto:support@fkstores.com" style="color:#243e6b;font-weight:600;">support@fkstores.com</a>.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color:#f9fafb;padding:24px 40px;text-align:center;border-top:1px solid #e5e7eb;">
              <p style="margin:0 0 4px;font-size:12px;color:#9ca3af;">
                © {{year}} FKstores — Golden Shopping Experience. This is an automated message.
              </p>
              <p style="margin:0;font-size:12px;">
                <a href="https://fkstores.com" style="color:#243e6b;text-decoration:none;">fkstores.com</a>
                &nbsp;·&nbsp;
                <a href="mailto:support@fkstores.com" style="color:#243e6b;text-decoration:none;">Support</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
