# App Environment
APP_ENVIRONMENT=dev
PORT=3000
FRONTEND_URL=http://localhost:3000

# Database Configuration (MySQL)
HOST=localhost
MYSQL_USERNAME_LOCAL=root
MYSQL_PASSWORD_LOCAL=password
MYSQL_DATABASE_LOCAL=KandF_db

MYSQL_USERNAME_LIVE=root
MYSQL_PASSWORD_LIVE=
MYSQL_DATABASE_LIVE=

# Email Service (ZeptoMail)
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_API_KEY=Zoho-enczapikey your_api_key_here
MAIL_FROM=donotreply@fkstores.com

# Redis Queue Configuration (High-Volume Email Scaling)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
